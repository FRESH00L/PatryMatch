# ---------------------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...          # public, used only for Realtime
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...              # SECRET — server only, bypasses RLS

# ---------------------------------------------------------------------------
# Cloudflare R2  (Dashboard -> R2 -> Manage API Tokens)
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=0123456789abcdef0123456789abcdef
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=partymatch-photos
# Public read URL of the bucket: the r2.dev subdomain, or your own CDN domain.
R2_PUBLIC_BASE_URL=https://cdn.twojadomena.pl

# ---------------------------------------------------------------------------
# App secrets
# ---------------------------------------------------------------------------
ADMIN_SECRET=change-me-to-a-long-random-string    # gate for /admin party creation
CRON_SECRET=change-me-too                         # gate for /api/cron/cleanup

# ---------------------------------------------------------------------------
# Monetisation (optional — leave empty to show only venue sponsor cards)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# ---------------------------------------------------------------------------
# Legal (shown on the privacy page)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTROLLER_EMAIL=
